# =============================================================================
# Primaxs Marketing (M) Sdn Bhd — Apache directives
# https://www.storagesystem.com.my
#
# PORTABILITY NOTE
# The live site is served by Cloudflare, which reads `docs/_headers` (generated
# by site/build.py) and handles Brotli/zstd negotiation itself. This file is the
# equivalent config for an Apache origin — use it only if the site is moved off
# Cloudflare. Copy to the document root alongside the built `docs/` output.
# =============================================================================

# ----------------------------------------------------------------- compression
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    application/rss+xml image/svg+xml
  # Legacy UA bugs
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  Header append Vary User-Agent env=!dont-vary
</IfModule>

# --------------------------------------------------------------- browser cache
<IfModule mod_expires.c>
  ExpiresActive On

  # Fingerprinted assets — site.css / *.js carry a ?v= cache-buster, and
  # product images under /asset3/ never change once published.
  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/x-icon                  "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"

  # HTML must stay short so deploys propagate.
  ExpiresByType text/html                     "access plus 5 minutes"
  ExpiresByType application/xml               "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # ------------------------------------------------------------- security
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
</IfModule>

# ------------------------------------------------------- canonical host + TLS
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://www.storagesystem.com.my/$1 [R=301,L]

  # Apex -> www (matches the live Cloudflare behaviour)
  RewriteCond %{HTTP_HOST} ^storagesystem\.com\.my$ [NC]
  RewriteRule ^(.*)$ https://www.storagesystem.com.my/$1 [R=301,L]

  # Enforce trailing slash on directory-style URLs so canonicals stay unique
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# --------------------------------------------------------------------- 404
ErrorDocument 404 /404.html
